// Hybrid execution config: heavy steps on Slurm, lightweight steps local.
// Use with: nextflow run ... -c nextflow.config

process {
    executor = 'slurm'
    queue = 'day'
    time = '1h'

    // Keep lightweight steps local to avoid queue wait times
    withName: 'MULTIQC|CUSTOM_DUMPSOFTWAREVERSIONS' {
        executor = 'local'
    }
}

apptainer {
    enabled = true
    cacheDir = "${HOME}/scratch/apptainer_cache"
}
